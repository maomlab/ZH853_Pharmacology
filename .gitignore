# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# External comparator structures — re-fetchable via `make fetch` (RCSB), kept out of VCS
data/comparators/*.pdb

# Node / MolStar headless render deps + build artifacts (regenerate via npm install + render.js)
node_modules/
src/03.10.00_molstar_render/pocket.mvsj
src/03.10.00_molstar_render/overview_camera.json

# Intermediate / large simulation artifacts (kept out of VCS; regenerate via Makefile)
intermediate/
*.dcd
*.xtc
*.trr
*.chk
*.h5
*.npz
*.log

# SLURM bundle: generated by PACKMOL-Memgen / tleap / OpenMM / SLURM (component + bilayer PDBs,
# packmol.inp, packmol-memgen.json, prmtop/rst7, .xml states, *_%j.out job logs). The tracked
# source in this dir is only *.sh *.py *.sbatch tleap.in README.md.
src/02.10.00_slurm_bundle/*.pdb
src/02.10.00_slurm_bundle/*.inp
src/02.10.00_slurm_bundle/*.json
src/02.10.00_slurm_bundle/*.prmtop
src/02.10.00_slurm_bundle/*.rst7
src/02.10.00_slurm_bundle/*.crd
src/02.10.00_slurm_bundle/*.xml
src/02.10.00_slurm_bundle/*.out
# ligand parameterization scratch (antechamber/RESP) -- keep only the script
src/02.10.00_slurm_bundle/ligand_resp/*
!src/02.10.00_slurm_bundle/ligand_resp/run_resp.sh

# Regenerable dated MD-prep reports (a fresh date is written on each `make prep` re-run;
# a committed snapshot already exists -- force-add a new date only to re-snapshot)
product/02.01.00_prep_assessment_*.md
product/02.02.00_protonation_*.md
product/02.03.00_receptor_prep_*.md
product/02.04.00_ligand_prep_*.md

# OS / editor
.DS_Store
*.swp
