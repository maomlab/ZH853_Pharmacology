# Editor / REPL scratch
.Rapp.history
.Rhistory
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# External comparator structures — re-fetchable via `make fetch` (RCSB), kept out of VCS
data/comparators/*.pdb
data/opm/*.pdb          # OPM-oriented reference, re-fetchable via prep-receptor-orient

# Node / MolStar headless render deps + build artifacts (regenerate via npm install + render.js)
node_modules/
src/03.10.00_molstar_render/pocket.mvsj
src/03.10.00_molstar_render/membrane.mvsj
src/03.10.00_molstar_render/membrane_calib.json
src/03.10.00_molstar_render/overview_camera.json

# Intermediate / large simulation artifacts (kept out of VCS; regenerate via the Makefile or,
# for the MD builds, src/02.10.00_slurm_bundle/01_build_system.sh). This one rule covers every
# generated data product: prep outputs, ligand parameters and the timestamped MD build dirs.
intermediate/
*.dcd
*.xtc
*.trr
*.chk
*.h5
*.npz
*.log

# SLURM bundle. Generated artefacts no longer land here: builds go to
# intermediate/02.10.00_build/<LIGAND>_<D250>_<timestamp>/ and ligand parameters to
# intermediate/02.08.00_ligand_params/, both covered by the blanket `intermediate/` above. Only
# two things are still written into the bundle directory itself:
#
#   *.out  -- SLURM job logs, which land in the SUBMISSION directory. The GPU stages are submitted
#             from a build directory (covered by `intermediate/`), but the pre-flight and the two
#             CPU array stages are submitted from here, leaving gpucheck_/params_/build_*.out.
src/02.10.00_slurm_bundle/*.out

# Filled-in site settings: account, partitions, resources, wall-times. Per-cluster and per-user,
# so never tracked; the template cluster.env.example is. Lives at the repository root so one edit
# covers every build. (Per-build sampling.env sits under intermediate/, already ignored.)
cluster.env

# Regenerable dated snapshots written directly in product/ on each `make` re-run (YYYYMMDD).
# The tracked deliverables are product/manuscript/* (stable-named figures + the compiled PDF);
# the committed baseline snapshots remain tracked. Force-add a new date only to re-snapshot.
# (`*` does not cross `/`, so product/manuscript/... is unaffected.)
product/*_20[0-9][0-9][0-9][0-9][0-9][0-9].*

# OS / editor
*.swp
