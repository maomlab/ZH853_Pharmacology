# ==============================================================================
# Cluster/site settings for this repository.
#
#   cp cluster.env.example cluster.env    # then edit; cluster.env is gitignored
#
# CONFIGURE THIS BEFORE ANYTHING ELSE ON THE CLUSTER. Every batch stage -- the CPU prep and build
# jobs and all the GPU stages -- refuses to run without it rather than falling back to defaults.
#
# It holds only what is true of the MACHINE and your allocation: where jobs run, how big, for how
# long, and which conda envs to activate. Anything that changes the SCIENCE lives per build, in
# the sampling.env that 01_build_system.sh writes into each build directory -- so re-running a
# system with different sampling cannot silently reuse another build's settings.
#
# Plain shell (sourced, not parsed): quote anything with spaces. Only the first two fields have
# no working default.
# ==============================================================================

# --- required ---------------------------------------------------------------------------------
# Allocation to charge. `sacctmgr show assoc user=$USER format=account,partition,qos` lists what
# you may use; on Great Lakes this is typically <pi-uniqname>0 or a named lab allocation.
ZH_ACCOUNT=

# --- CPU stages ---------------------------------------------------------------------------------
# `./submit.sh params` (ligand parameters) and `./submit.sh build` (system builds). Both are job
# arrays and neither touches a GPU, so they request no --gres. ZH_CPU_PARTITION left empty falls
# back to ZH_GPU_PARTITION, which works but may queue behind GPU demand and wastes an allocation.
ZH_CPU_PARTITION=
ZH_CPU_TIME=04:00:00           # per array task: one ligand, or one system build (~15 min each)
ZH_CPU_CPUS=8
ZH_CPU_MEM=32G

# --- GPU stages ---------------------------------------------------------------------------------
# `./submit.sh check | eq | preprod | prod`. Pin the GPU model in ZH_GPU_GRES if the partition
# mixes them and the run must be reproducible, e.g. gpu:a100:1 or gpu:h200:1 -- `sinfo -o "%P %G"`
# shows what each partition has.
ZH_GPU_PARTITION=
ZH_GPU_GRES=gpu:1
ZH_GPU_CPUS=8
ZH_GPU_MEM=32G

# One wall-time per stage. submit.sh prints an estimate against each from the ns/day measured in
# the build directory and warns past 85%, but the request must be made before the job runs.
#
# MEASURED on the H200 nodes for the ~180k-atom apo system (2026-09-01): 94.4 ns/day at 2 fs
# restrained, 587 ns/day at 4 fs with HMR. At those rates:
#     eq       2.25 ns ->  0.6 h   ( 5% of 12 h)
#     preprod   100 ns ->  4.1 h   (17% of 24 h)
#     prod      500 ns -> 20.4 h   (28% of 72 h, per replica)
# 72 h is comfortable rather than necessary; kept generous because a job that hits the limit
# loses everything since its last checkpoint, and the ligand builds are larger and slower.
ZH_GPU_EQ_TIME=12:00:00
ZH_GPU_PREPROD_TIME=24:00:00
ZH_GPU_PROD_TIME=72:00:00
ZH_GPU_CHECK_TIME=00:05:00

# --- applied to every stage ---------------------------------------------------------------------
# Optional: QOS, node constraint, and any extra sbatch flags (word-split, so no spaces per flag).
ZH_QOS=
ZH_CONSTRAINT=
ZH_EXTRA_SBATCH=

# --- software environment ---------------------------------------------------------------------
# Modules to load inside the job, space-separated. OpenMM (conda-forge) bundles its own CUDA
# runtime and needs only the node's NVIDIA driver, so this is normally EMPTY -- see the CUDA
# section of src/02.10.00_slurm_bundle/README.md before adding `cuda` here.
ZH_MODULES=

# conda.sh path; the default asks conda itself. Set only if conda is not on PATH at job start.
ZH_CONDA_SH=

ZH_SIM_ENV=zh853mor-sim
ZH_PREP_ENV=zh853mor-prep
