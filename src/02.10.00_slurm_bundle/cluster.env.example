# ==============================================================================
# Cluster-specific SLURM settings for the ZH853-MOR bundle  (formerly TODO(OQ-3))
#
#   cp cluster.env.example cluster.env    # then edit; cluster.env is gitignored
#
# This is the ONE place where account / partition / GPU / wall-time live. `submit.sh` sources it
# and passes the values to sbatch as command-line flags, which override any `#SBATCH` directive in
# the job scripts -- so the .sbatch files stay cluster-agnostic and nothing has to be edited per
# machine or per build. It is plain shell (sourced, not parsed): quote anything with spaces.
#
# Everything after ZH_MEM has a working default; the first two must be filled in.
# ==============================================================================

# --- required ---------------------------------------------------------------------------------
# Your allocation. `sacctmgr show assoc user=$USER format=account,partition,qos` lists what you
# may charge to; on Great Lakes this is typically <pi-uniqname>0 or a named lab allocation.
ZH_ACCOUNT=

# GPU partition/queue name. `sinfo -s` lists them.
ZH_PARTITION=

# --- resources --------------------------------------------------------------------------------
# GPU request. Pin the model if the partition mixes them and the run must be reproducible,
# e.g. gpu:a100:1 or gpu:h200:1 -- `sinfo -o "%P %G"` shows what each partition has.
ZH_GRES=gpu:1

ZH_CPUS=8
ZH_MEM=32G

# Wall-times. Equilibration is 2.25 ns at 2 fs (six restrained stages); production is
# ZH_PROD_NS per replica at 4 fs with HMR. submit.sh prints an estimate against each of these
# from the measured ns/day and warns past 85%, so you do not have to guess -- but the request has
# to be made BEFORE the job runs, hence these defaults.
#
# MEASURED on the H200 nodes for the ~180k-atom apo system (2026-09-01): 94.4 ns/day at 2 fs
# restrained, 587 ns/day at 4 fs with HMR. That puts the defaults below at:
#     eq       2.25 ns ->  0.6 h   ( 5% of 12 h)
#     preprod   100 ns ->  4.1 h   (17% of 24 h)
#     prod      500 ns -> 20.4 h   (28% of 72 h, per replica)
# 72 h is therefore comfortable rather than necessary -- 48 h would also have fitted. It is kept
# generous because a job that hits the limit loses everything since the last checkpoint, and
# because a larger system (the ligand builds) will be slower. submit.sh prints the estimate from
# the rate measured in YOUR build directory and warns past 85%; trust that over these numbers.
ZH_EQ_TIME=12:00:00
ZH_PROD_TIME=72:00:00
ZH_CHECK_TIME=00:05:00

# Optional: QOS, node constraint, and any extra sbatch flags (word-split, so no spaces per flag).
ZH_QOS=
ZH_CONSTRAINT=
ZH_EXTRA_SBATCH=

# --- sampling ----------------------------------------------------------------------------------
# Unrestrained pre-production (step 3.5): equilibration, not sampling -- it is DISCARDED. The
# 2.25 ns restrained ramp cannot equilibrate a PACKMOL-built bilayer, whose lipids start in an
# artificially ordered extended conformation; area per lipid takes tens of ns to converge. Raise
# this if check_equilibration.py still reports "area/lipid drift" as WARN afterwards.
ZH_PREPROD_NS=100
ZH_PREPROD_TIME=24:00:00

ZH_REPLICAS=3          # job-array size; SPECIFICATION QC wants >=3 for a replicate spread
ZH_PROD_NS=500

# Gate the chain on QC: when 1 (default), a check_equilibration.py FAIL exits the eq/preprod job
# non-zero, so anything chained with --dependency=afterok never starts on a broken system. A WARN
# (still relaxing) does not block. Set 0 to run the QC for information only.
ZH_QC_GATE=1

# Force the state production resumes from. Empty = preprod_final.xml if it exists, else the ramp.
ZH_PROD_STATE=

# --- software environment ---------------------------------------------------------------------
# Modules to load inside the job, space-separated. OpenMM (conda-forge) bundles its own CUDA
# runtime and needs only the node's NVIDIA driver, so this is normally EMPTY -- see the CUDA
# section of README.md before adding `cuda` here.
ZH_MODULES=

# conda.sh path; the default asks conda itself. Set only if conda is not on PATH at job start.
ZH_CONDA_SH=

ZH_SIM_ENV=zh853mor-sim
ZH_PREP_ENV=zh853mor-prep

# Basename of the tleap outputs and the equilibrated state (system.prmtop / system.rst7 /
# system_eq.xml). Only change this if you renamed the build products.
ZH_SYS=system
